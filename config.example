# ~/.config/just-desktops/config

# Draw the border around the focused window (on|off)
border = on

# ⌥Tab window switcher: list | square | off (on = list). When off, ⌥Tab is not captured and passes through to apps.
# square shows a screenshot of each window and asks for Screen Recording permission at launch; until it is
# granted it shows the app icon. The panel appears after ⌥ has been held about 150ms; a quick tap never draws it. After a rebuild macOS asks again (the grant follows the binary's code hash).
switcher = list

# Menu bar item (on|off): the current desktop's key and the apps on it. Costs about 5MB of memory when on
menubar = off

# Keys that switch desktops with ⌥ (and move the focused window with ⌥⇧).
# The n-th key is Desktop n. Digits and letters, at most 10. Default: 1 2 3 q w e
keys = 1 2 3 q w e

# Pin apps to a desktop: <bundle id> = <desktop number>
# A pin applies when a window first appears (app launch or new window); focusing it later pulls it to the current desktop.
# Find a bundle id with: osascript -e 'id of app "Safari"'
com.apple.Safari = 1
com.googlecode.iterm2 = 2
com.tinyspeck.slackmacgap = 3
